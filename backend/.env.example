# FraudX AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgresql://fraudx_user:your_password_here@localhost:5432/fraudx_db

# ── JWT Authentication ───────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Integration (Optional) ───────────────────────────
# Uncomment and fill in if you want LLM-backed agent responses.
# If not set, the agent returns structured evidence without LLM summarisation.
# GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ── ML Configuration ─────────────────────────────────────
# Isolation Forest contamination rate (expected fraud fraction, 0.0 to 0.5)
ML_CONTAMINATION=0.05
# Minimum risk score to generate an alert (0–100)
ALERT_THRESHOLD=55
# Directory for persisted model artifacts
MODEL_DIR=data/models

# ── Email Delivery Service (Verification Codes & MFA) ─────
# Provider options: auto, smtp, resend, sendgrid, brevo
EMAIL_PROVIDER=auto

# Option 1: Standard SMTP (Gmail, Mailgun, Amazon SES, Outlook, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=security@fraudx.ai
# SMTP_FROM_NAME=FraudX AI Security

# Option 2: Resend API (https://resend.com)
# RESEND_API_KEY=re_123456789_abcdef

# Option 3: SendGrid API (https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Option 4: Brevo / Sendinblue API (https://brevo.com)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# ── App ──────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
